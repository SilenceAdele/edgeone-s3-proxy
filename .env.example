# edgeone-s3-proxy environment variable template
# Copy these into the EdgeOne Pages console: Project -> Settings -> Environment Variables.
#
# WARNING: this file lists variable names only. It contains no real values.
# WARNING: if you create a local .env for testing, keep it out of git (see .gitignore).

# ---- Required ----
# S3 AccessKeyID (recommend setting the type to Secret)
AWS_ACCESS_KEY_ID=

# S3 AccessKeySecret (must be set as type Secret)
AWS_SECRET_ACCESS_KEY=

# Bucket name
S3_BUCKET=

# S3 endpoint hostname. No https:// prefix.
S3_ENDPOINT=

# ---- Optional ----
# Region used for signing. Default: cn-north-1
#S3_REGION=cn-north-1

# User-Agent prefix. The gateway gates on this; use the application name the
# key is bound to. Default: S3Drive
#UA_PREFIX=S3Drive

# Allowed file extensions (regex). Default: images and other static files.
#ALLOWED_EXT=\.(png|jpe?g|gif|webp|svg|avif|bmp|ico|mp4|webm|pdf|json|txt|md)$

# ---- Landing page gate ----
# REQUIRED. Token protecting the landing page at "/", and the fallback that
# authorises direct object opens (address bar, curl) once the Referer allowlist
# is set. Images embedded by a whitelisted host need no token.
# Leave it empty and "/" answers 503 instead of rendering.
# Generate with: openssl rand -hex 24
PROXY_TOKEN=

# ---- Object access control ----
# Comma-separated Referer hostnames allowed to load objects. Hostnames only,
# optionally with a port; a pasted scheme/path is stripped.
#   * host in the list        -> served (the blog embeds images this way)
#   * any other host          -> 403, even with a token
#   * no Referer at all       -> needs PROXY_TOKEN, else 401
# Empty = feature off, every request is served.
# Add a host only once it actually serves pages: matching is exact, and a port
# is part of the host.
#IMG_REFERER_WHITELIST=blog.example.com,localhost:5173,127.0.0.1:5173
